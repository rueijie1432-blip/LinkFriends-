@{
    ViewData["Title"] = "Index";
}

<div class="container mt-5">

    <h1 class="mb-4">管理員後台</h1>

    <div class="row">

        <!-- 使用者管理 -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">使用者管理</h4>
                    <p class="card-text">
                        查看所有註冊使用者資料。
                    </p>

                    <a asp-controller="Admin"
                       asp-action="ReadAccounts"
                       class="btn btn-primary">
                        查看使用者
                    </a>
                    <p style="color: blue";>使用者總數：@ViewBag.AccountCount</p>
                </div>
            </div>
        </div>

        <!-- 作品管理 -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">作品管理</h4>
                    <p class="card-text">
                        查看與管理使用者作品。
                    </p>

                    <a asp-controller="Admin"
                       asp-action="ReadPortfolios"
                       class="btn btn-primary">
                        查看作品
                    </a>

                    <p style="color: blue;">作品總數：@ViewBag.PortfolioCount</p>
                </div>
            </div>
        </div>

        <!-- 留言管理 -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">留言管理</h4>
                    <p class="card-text">
                        查看與管理使用者留言。
                    </p>

                    <a asp-controller="Admin"
                       asp-action="ReadPortfolioComments"
                       class="btn btn-primary">
                        查看留言
                    </a>

                    <p style="color: blue;">作品留言總數：@ViewBag.CommentCount</p>
                </div>
            </div>
        </div>

    </div>

</div>