@model MVC_DB_.Models.account

@{
    ViewData["Title"] = "註冊會員";
}

<div class="register-page">
    <div class="register-card">

        <div class="register-header">
            <div class="register-icon">
                <i class="bi bi-person-plus-fill"></i>
            </div>

            <h2>建立帳號</h2>
            <p>歡迎加入我們，立即建立你的專屬帳號</p>
        </div>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group">
                <label asp-for="name">使用者名稱</label>
                <input asp-for="name"
                       class="form-control"
                       placeholder="請輸入你的名稱" />
                <span asp-validation-for="name"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="userName">帳號</label>
                <input asp-for="userName"
                       class="form-control"
                       placeholder="請設定登入帳號"
                       autocomplete="username" />
                <span asp-validation-for="userName"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="passwd">密碼</label>
                <input asp-for="passwd"
                       type="password"
                       class="form-control"
                       placeholder="請設定登入密碼"
                       autocomplete="new-password" />
                <span asp-validation-for="passwd"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="register-btn">
                建立帳號
                <i class="bi bi-arrow-right"></i>
            </button>

        </form>

        <div class="register-footer">
            已經有帳號了嗎？
            <a asp-action="Login">立即登入</a>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
