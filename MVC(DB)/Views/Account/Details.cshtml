@model MVC_DB_.Models.account

@{
    ViewData["Title"] = "Details";
}

<h1>個人資料</h1>

<div>

    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            帳號
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.userName)
        </dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">
            姓名
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.name)
        </dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">
            頭像
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.avatar))
            {
                <img src="/images/avatar/@Model.avatar" width="300" />
            }
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit">編輯</a>

</div>
