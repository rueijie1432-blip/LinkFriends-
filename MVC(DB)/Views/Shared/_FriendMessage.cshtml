<!-- 聊天視窗 -->
<div id="friendMessageBox"
     style="display:none;
    position:fixed;
    right:20px;
    bottom:20px;
    width:320px;
    height:400px;
    border:1px solid #ccc;
    background:white;
    z-index:1000;">

    <!-- 聊天標題 -->
    <div style="padding:10px; border-bottom:1px solid #ccc;">
        <strong id="chatFriendName">好友聊天</strong>

        <button onclick="closeChat()"
                style="float:right;">
            ×
        </button>
    </div>

    <!-- 留言區 -->
    <div id="messageList"
         style="height:300px;
        overflow-y:auto;
        padding:10px;">
    </div>

    <!-- 輸入區 -->
    <div style="padding:10px; border-top:1px solid #ccc;">

        <input type="text"
               id="messageInput"
               placeholder="輸入留言..."
               style="width:230px;" />

        <button onclick="sendMessage()">
            送出
        </button>

    </div>

</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="~/js/FriendMessage.js"></script>